enl [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#c2410c" bgcolor="#fff1e6"><tr><td colspan="2" bgcolor="#c2410c"><font color="white"><b>RED_ENLACES</b></font></td></tr><tr><td colspan="2" bgcolor="white"><font point-size="9" color="#c2410c"><i>Modelos/data/red_proveeduria_enlaces(_top5).parquet · carto/…_top5.geojson</i></font></td></tr><tr><td align="left" width="26" port="a0_l"><font color="#1d4ed8"><b>FK</b></font></td><td align="left" port="a0">id_proveedor</td></tr><tr><td align="left" width="26" port="a1_l"><font color="#1d4ed8"><b>FK</b></font></td><td align="left" port="a1">id_comprador</td></tr><tr><td align="left" width="26" port="a2_l"><font color="#1d4ed8"><b>FK</b></font></td><td align="left" port="a2">cvegeo_mun_p / cvegeo_mun_c</td></tr><tr><td align="left" width="26" port="a3_l"></td><td align="left" port="a3">oem_grupo_c · participacion_comprador</td></tr><tr><td align="left" width="26" port="a4_l"></td><td align="left" port="a4">confiabilidad · confianza_enlace</td></tr><tr><td align="left" width="26" port="a5_l"></td><td align="left" port="a5">LineString (CRS84)</td></tr></table>>];
nod [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#c2410c" bgcolor="#fff1e6"><tr><td colspan="2" bgcolor="#c2410c"><font color="white"><b>RED_NODOS</b></font></td></tr><tr><td colspan="2" bgcolor="white"><font point-size="9" color="#c2410c"><i>Modelos/data/red_proveeduria_nodos.parquet · carto/…nodos.geojson</i></font></td></tr><tr><td align="left" width="26" port="a0_l"><font color="#b45309"><b>PK</b></font></td><td align="left" port="a0">id_unidad</td></tr><tr><td align="left" width="26" port="a1_l"><font color="#1d4ed8"><b>FK</b></font></td><td align="left" port="a1">cvegeo_mun</td></tr><tr><td align="left" width="26" port="a2_l"></td><td align="left" port="a2">tier_red · oem_grupo</td></tr><tr><td align="left" width="26" port="a3_l"></td><td align="left" port="a3">intermediación · PageRank · grados</td></tr></table>>];
roc [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#c2410c" bgcolor="#fff1e6"><tr><td colspan="2" bgcolor="#c2410c"><font color="white"><b>RESUMEN_RED_POR_OEM</b></font></td></tr><tr><td colspan="2" bgcolor="white"><font point-size="9" color="#c2410c"><i>Modelos/data/resumen_red_por_oem.csv</i></font></td></tr><tr><td align="left" width="26" port="a0_l"><font color="#b45309"><b>PK</b></font></td><td align="left" port="a0">oem</td></tr><tr><td align="left" width="26" port="a1_l"></td><td align="left" port="a1">proveedores T1 · T2 · T3</td></tr><tr><td align="left" width="26" port="a2_l"></td><td align="left" port="a2">flujo directo · distancia ponderada</td></tr></table>>];
py [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3" color="#c2410c" bgcolor="#fff1e6"><tr><td colspan="2" bgcolor="#c2410c"><font color="white"><b>red_proveeduria.py</b></font></td></tr><tr><td colspan="2" bgcolor="white"><font point-size="9" color="#c2410c"><i>Modelos/codigos · pipeline</i></font></td></tr><tr><td align="left" width="26" port="a0_l"></td><td align="left" port="a0">auditar_red() · construir_catalogo_oem()</td></tr><tr><td align="left" width="26" port="a1_l"></td><td align="left" port="a1">filtrar_red() · construir_grafo()</td></tr><tr><td align="left" width="26" port="a2_l"></td><td align="left" port="a2">metricas_red() · resumen_red_por_oem()</td></tr></table>>];
}
subgraph cluster_scr { label=<<b>Scripts/</b>>; fontcolor="#455a64"; color="#455a64"; style="rounded,dashed"; fontsize=18; margin=14;
scr [shape=box style="rounded,filled" fillcolor="#eceff1" color="#455a64" fontcolor="#263238" label="Scripts/  (capa de presentación, Leaflet)\nGlobal · Nacional · Estatal · Metropolitana · Municipal · modelos.js\nindex.html"];
}
legend [shape=plaintext label=<<table border="1" cellborder="0" cellpadding="4" color="#9ca3af" bgcolor="white">
<tr><td colspan="2"><b>Simbología</b></td></tr>
<tr><td><font color="#b45309"><b>PK</b></font></td><td align="left">Llave primaria</td></tr>
<tr><td><font color="#1d4ed8"><b>FK</b></font></td><td align="left">Llave foránea explícita (código)</td></tr>
<tr><td><font color="#6b7280"><b>LK</b></font></td><td align="left">Llave lógica por nombre / espacial (sin código común)</td></tr>
<tr><td>━━━</td><td align="left">Relación por llave (cardinalidad pata de gallo)</td></tr>
<tr><td><font color="#6b7280">- - -</font></td><td align="left">Relación por nombre o proximidad</td></tr>
<tr><td><font color="#c2410c">━━▶</font></td><td align="left">Derivación de la nueva fuente</td></tr>
<tr><td><font color="#90a4ae">· · ▶</font></td><td align="left">Consumo / lectura</td></tr>
<tr><td bgcolor="#fff1e6"> </td><td align="left">Nueva fuente: Red de proveeduría Tier 0–3</td></tr>
</table>>];
